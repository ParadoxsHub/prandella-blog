<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.github.paradoxshub.prandellablog.mappers.UserMapper">

    <insert id="insertUser" parameterType="com.github.paradoxshub.prandellablog.entity.User"
            useGeneratedKeys="true"
            keyProperty="id">
        insert into "user" (username, nickname, password, email, created_at, updated_at,
                            created_by, updated_by, age, gender, is_admin, is_ban, avatar)
        values (#{username,jdbcType=VARCHAR},
                #{nickname},
                #{password},
                #{email},
                now(),
                now(),
                #{created_by},
                #{updated_by},
                #{age},
                #{gender},
                #{admin},
                #{ban},
                #{avatar}
                );
    </insert>

    <delete id="deleteUserById" parameterType="java.lang.Long">
        delete from "user" where id = #{id};
    </delete>

